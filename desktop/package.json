{
  "name": "mughalerajdesktopapp",
  "version": "1.0.0",
  "description": "Mughal E Raj Restaurant Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64"
  },
  "author": "Munna",
  "license": "ISC",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.mughaleraj.desktop",
    "productName": "Mughal E Raj Desktop Management",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "kitchen-preload.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}